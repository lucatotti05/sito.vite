# Intestazioni per Netlify
/*
  X-Robots-Tag: noindex, nofollow

# Il service worker e la pagina vanno sempre ricontrollati, così gli aggiornamenti arrivano subito
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/
  Cache-Control: no-cache
/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache
